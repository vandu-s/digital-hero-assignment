// Prisma schema for the Lead Management CRM.
// Run `npm run prisma:migrate --workspace=server` after editing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Leads currently assigned to this user (nullable FK on Lead)
  assignedLeads Lead[]     @relation("AssignedLeads")
  // Leads this user originally created
  createdLeads  Lead[]     @relation("CreatedLeads")
  notes         Note[]
  activities    Activity[]

  @@map("users")
}

model Lead {
  id     String  @id @default(uuid())
  name   String
  email  String
  phone  String?
  company String?
  message String? // the visitor's message from the public capture form
  source String? // e.g. "Website", "Referral", "Cold Call"
  value  Decimal? @db.Decimal(12, 2) // potential deal value

  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedLeads", fields: [createdById], references: [id])

  notes      Note[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // These two columns are filtered/sorted on constantly (leads list, dashboard stats)
  @@index([status])
  @@index([assignedToId])
  @@map("leads")
}

model Note {
  id       String @id @default(uuid())
  body     String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("notes")
}

// Append-only audit log. The Lead Details "Timeline" and "Status History"
// UI are both just filtered reads of this table - one source of truth.
model Activity {
  id      String @id @default(uuid())
  type    String // "CREATED" | "STATUS_CHANGED" | "ASSIGNED" | "NOTE_ADDED"
  message String // human-readable, e.g. "Status changed: NEW -> CONTACTED"

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("activities")
}
