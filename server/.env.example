# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_crm?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS - the client origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# bcrypt
BCRYPT_SALT_ROUNDS=10
